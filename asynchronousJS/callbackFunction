//Asynchronous Callback Example
//with parameter with argument
function geet (userId,callbackWhenDone) {
    console.log("wait for me");

setTimeout (function(){
 let userData = { id: userId, name: "Rahul", age: 16 };
callbackWhenDone(userData);

},4000);
}
function jayash(data)
{
    console.log("let's dance",data);
}

geet (101,jayash);
